{
  "compilerOptions": {
    "baseUrl": "./",
    "module": "NodeNext",
    "target": "ES6",
    "lib": ["ES2021"],
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
