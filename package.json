{
  "name": "@ralfstx/opentype",
  "version": "0.1.0",
  "description": "Library for parsing OpenType and TrueType font files, font subsetting, and text layout.",
  "license": "MIT",
  "keywords": [
    "opentype",
    "truetype",
    "font",
    "fonts",
    "typography"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/ralfstx/opentype.git"
  },
  "homepage": "https://github.com/ralfstx/opentype",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.js",
    "module": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist/ && tsc && esbuild src/index.ts --bundle --platform=node --outdir=dist --format=esm",
    "test": "vitest run test",
    "verify": "npm run lint && npm run test && npm run build",
    "format": "prettier --write .",
    "fix": "eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  }
}
